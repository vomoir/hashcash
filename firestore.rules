rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Wallets: Anyone can read, only owner can create/update
    match /wallets/{address} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Transactions: Anyone can read, only owner of 'from' address can create
    match /transactions/{txId} {
      allow read: if true;
      allow create: if request.auth != null && 
                    (request.resource.data.from == 'GOD_MOD_BENEFACTOR' || 
                     get(/databases/$(database)/documents/wallets/$(request.resource.data.from)).data.ownerUid == request.auth.uid);
    }

    // Blockchain: Anyone can read, anyone can add a block (mining is open)
    match /blockchain/{blockId} {
      allow read: if true;
      allow create: if true; 
    }
  }
}
